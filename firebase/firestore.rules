rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function entryPath(entryId) {
      return /databases/$(database)/documents/entries/$(entryId);
    }

    // 로그인한 사용자가 볼 수 있는 기록인지 (공개 또는 내 기록)
    function canSeeEntry(entryId) {
      let e = get(entryPath(entryId)).data;
      return signedIn() && (e.isPublic == true || e.ownerId == request.auth.uid);
    }

    function createdNow() {
      return request.resource.data.createdAt == request.time;
    }

    // 신고 누적으로 활동 정지 중이 아닌지 (정지 정보는 서버만 씁니다)
    function notSuspended() {
      let m = /databases/$(database)/documents/users/$(request.auth.uid)/private/moderation;
      return !exists(m) || get(m).data.get('suspendedUntil', request.time) <= request.time;
    }

    // ── 사용자 ───────────────────────────────────────────────
    // 통계(stats)·팔로워 수는 서버(Cloud Functions)만 바꿉니다.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isUser(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'bio', 'photoUrl', 'createdAt'])
        && validProfile(request.resource.data);
      allow update: if isUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'bio', 'photoUrl'])
        && validProfile(request.resource.data);
      allow delete: if false;

      function validProfile(data) {
        return data.displayName is string
          && data.displayName.size() > 0 && data.displayName.size() <= 30
          && (!('bio' in data) || (data.bio is string && data.bio.size() <= 150))
          && (!('photoUrl' in data) || data.photoUrl == null || data.photoUrl is string);
      }

      // 좋아요: 본인 것만. 기록의 likeCount 가 같은 요청에서 정확히 +1 / -1 될 때만 허용
      match /likes/{entryId} {
        allow read: if isUser(uid);
        allow create: if isUser(uid)
          && request.resource.data.keys().hasOnly(['createdAt', 'entryId'])
          && request.resource.data.entryId == entryId
          && createdNow()
          && notSuspended()
          && getAfter(entryPath(entryId)).data.get('likeCount', 0) == get(entryPath(entryId)).data.get('likeCount', 0) + 1;
        allow delete: if isUser(uid)
          && (!exists(entryPath(entryId))
              || getAfter(entryPath(entryId)).data.get('likeCount', 0) == get(entryPath(entryId)).data.get('likeCount', 0) - 1);
      }

      // 책갈피: 본인만
      match /bookmarks/{entryId} {
        allow read, delete: if isUser(uid);
        allow create: if isUser(uid)
          && request.resource.data.keys().hasOnly(['createdAt', 'entryId'])
          && request.resource.data.entryId == entryId
          && createdNow();
      }

      // 팔로우: 내가 팔로우하는 목록만 직접 씁니다. 상대의 followers 는 서버가 만듭니다.
      match /following/{target} {
        allow read: if signedIn();
        allow create: if isUser(uid) && target != uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && createdNow()
          && notSuspended();
        allow delete: if isUser(uid);
      }
      match /followers/{follower} {
        allow read: if signedIn();
        allow write: if false;
      }

      // 차단: 본인만
      match /blocked/{target} {
        allow read, delete: if isUser(uid);
        allow create: if isUser(uid) && target != uid
          && request.resource.data.keys().hasOnly(['createdAt', 'displayName'])
          && createdNow();
      }

      // 알림: 서버가 만들고, 본인은 읽음 표시와 삭제만
      match /notifications/{notificationId} {
        allow read, delete: if isUser(uid);
        allow update: if isUser(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create: if false;
      }

      // 신고 경고 기록: 서버만
      match /strikes/{strikeId} {
        allow read, write: if false;
      }

      // 비공개 설정: 푸시 토큰(fcm)·알림 설정(prefs)은 본인이, 사용량(quota)·활동 정지(moderation)는 서버만
      match /private/{doc} {
        allow read: if isUser(uid);
        allow write: if isUser(uid) && doc == 'fcm'
          && request.resource.data.keys().hasOnly(['tokens'])
          && request.resource.data.tokens is list
          && request.resource.data.tokens.size() <= 10;
        // 알림 설정(prefs): 본인이 종류별로 켜고 끕니다
        allow write: if isUser(uid) && doc == 'prefs'
          && request.resource.data.keys().hasOnly(['notifyLike', 'notifyComment', 'notifyFollow', 'push']);
      }
    }

    // ── 도감 기록 ─────────────────────────────────────────────
    // 등록은 서버 함수(createEntry)만 합니다 (위치·중복 규칙을 서버에서 확인).
    match /entries/{entryId} {
      function myLike() {
        return /databases/$(database)/documents/users/$(request.auth.uid)/likes/$(entryId);
      }

      allow read: if signedIn() && (
        resource == null
        || resource.data.isPublic == true
        || resource.data.ownerId == request.auth.uid
      );
      allow create: if false;
      // 주인: 공개 여부와 메모만 변경. 신고로 숨겨진 기록과 정보 정정이 필요한 기록은 공개할 수 없음
      // (정보 정정은 서버 함수 correctEntry 로)
      allow update: if isUser(resource.data.ownerId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPublic', 'memo'])
        && request.resource.data.isPublic is bool
        && request.resource.data.memo is string && request.resource.data.memo.size() <= 1000
        && !(resource.data.get('moderation', '') in ['hidden', 'needs_correction'] && request.resource.data.isPublic == true);
      // 좋아요 수: 내 좋아요 문서를 만들거나 지우는 요청에서만 ±1.
      // 좋아요는 볼 수 있는 기록에만, 취소는 그 뒤 비공개로 바뀐 기록에도 할 수 있습니다.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && (
          (request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1
            && (resource.data.isPublic == true || resource.data.ownerId == request.auth.uid)
            && !exists(myLike()) && existsAfter(myLike()))
          || (request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1
            && exists(myLike()) && !existsAfter(myLike()))
        );
      allow delete: if isUser(resource.data.ownerId);

      // 댓글: 볼 수 있는 기록에만. 작성자 이름과 댓글 수는 서버가 채웁니다.
      match /comments/{commentId} {
        allow read: if canSeeEntry(entryId);
        allow create: if canSeeEntry(entryId)
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'text', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && createdNow()
          && notSuspended();
        // 댓글 작성자 또는 기록 주인이 지울 수 있음
        allow delete: if signedIn() && (
          resource.data.authorId == request.auth.uid
          || get(entryPath(entryId)).data.ownerId == request.auth.uid
        );
      }
    }

    // ── 신고 ─────────────────────────────────────────────────
    // 누구나 신고할 수 있고, 내용은 관리자(Firebase 콘솔)만 봅니다.
    // 사유 코드(reasonCode)에 따라 서버가 숨김·정보 정정 요청·경고를 처리합니다 (functions/src/moderation.ts).
    match /reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporterId', 'targetType', 'targetId', 'entryId', 'targetOwnerId', 'reason', 'reasonCode', 'createdAt'])
        && request.resource.data.get('reasonCode', 'other') in ['not_real_photo', 'wrong_info', 'inappropriate_photo', 'abuse', 'spam', 'other']
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['entry', 'comment', 'user']
        && request.resource.data.targetId is string
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 300
        && createdNow();
    }
  }
}
